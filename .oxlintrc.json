{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "react",
    "jsx-a11y"
  ],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": [
    "storybook-static",
    "src/generated",
    "node_modules",
    "tests/visual/__screenshots__"
  ],
  "rules": {
    "jsx-a11y/prefer-tag-over-role": "off",
    "jsx-a11y/no-noninteractive-tabindex": "off"
  }
}
