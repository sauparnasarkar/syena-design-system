{
  "name": "@syena/ds",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Syena Design System: React components, design tokens and chart and table themes for climate and market analysis products.",
  "scripts": {
    "tokens": "node tokens/generators/run.mjs && node tokens/build.config.mjs",
    "tokens:generate": "node tokens/generators/run.mjs && node tokens/build.config.mjs",
    "storybook": "npm run tokens && storybook dev -p 6006",
    "build-storybook": "npm run tokens && storybook build",
    "typecheck": "npm run tokens && tsc -p tsconfig.json",
    "lint": "oxlint",
    "check:allowlist": "npm run tokens && node scripts/check-allowlist.mjs",
    "test": "npm run tokens && vitest run",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-vitest": "^10.6.2",
    "@storybook/react-vite": "^10.6.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser": "^5.0.4",
    "@vitest/browser-playwright": "^5.0.4",
    "culori": "^4.0.2",
    "fontkit": "^2.0.4",
    "oxlint": "^1.88.0",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.2",
    "style-dictionary": "^5.6.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css"
  },
  "types": "./src/index.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=22"
  }
}
